# Server-only. The Upland Ledger API base URL (the /v1 routes live under it).
LEDGER_URL=http://127.0.0.1:3000
# Optional bearer key for an authenticating proxy/tunnel in front of the ledger.
LEDGER_API_KEY=

# Sign in with GitHub (F-301). Register a GitHub OAuth app with callback
# URL <EMBERS_PUBLIC_ORIGIN>/auth/callback.
EMBERS_PUBLIC_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
EMBERS_SESSION_SECRET=
# Set only while rotating: the old secret, still accepted for open sessions.
EMBERS_SESSION_SECRET_PREVIOUS=
