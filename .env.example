# Server-only. The base every ledger path is appended to.
#   Through FORGE's gateway (production):  https://forge-api.40-160-143-106.sslip.io/api/ledger
#   A ledger directly (development):       http://127.0.0.1:3000/v1
LEDGER_URL=http://127.0.0.1:3000/v1
# Through FORGE's gateway: the shared assertion secret (never commit it), and
# the GitHub identity signed-out reads go out as (numeric id + login).
FORGE_API_ASSERTION_SECRET=
EMBERS_LEDGER_SUB=
EMBERS_LEDGER_LOGIN=

# Sign in with GitHub (F-301). Register a GitHub OAuth app with callback
# URL <EMBERS_PUBLIC_ORIGIN>/auth/callback.
EMBERS_PUBLIC_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
EMBERS_SESSION_SECRET=
# Set only while rotating: the old secret, still accepted for open sessions.
EMBERS_SESSION_SECRET_PREVIOUS=

# Feedback (F-1907): each submission becomes an issue in this repo. Feedback
# is off (the form says nothing was sent) unless all four are set.
EMBERS_FEEDBACK_GITHUB_TOKEN=
EMBERS_FEEDBACK_REPO=
# Cloudflare Turnstile on the feedback form (NFR-4): site key (public, inlined
# at build) and secret key (server only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
EMBERS_TURNSTILE_SECRET=
