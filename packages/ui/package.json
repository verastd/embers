{
  "name": "@embers/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Embers design system: tokens, self-hosted fonts and the Embers components (design_handoff_embers), ported to TSX. Feature code imports UI only from here.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/embers.css",
    "./fonts": "./src/fonts.ts",
    "./charts": "./src/charts/index.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css",
    "./src/fonts.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1",
    "eslint": "^9",
    "jsdom": "~25.0.1",
    "react": "~19",
    "react-dom": "~19",
    "storybook": "10.6.0",
    "typescript": "~5.6",
    "typescript-eslint": "^8",
    "vite": "~6.3.7",
    "vitest": "^2.1"
  },
  "dependencies": {
    "@fontsource/geist-mono": "~5.3.0",
    "@fontsource/work-sans": "~5.3.0",
    "echarts": "~6.1.0",
    "lucide-react": "~1.48.0",
    "next-themes": "~0.4.6"
  }
}
