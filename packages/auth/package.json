{
  "name": "@embers/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Sign in with GitHub for Embers \u2014 Edge-safe (Web Crypto + jose only, no node: imports), so Next middleware can import it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1",
    "eslint": "^9",
    "typescript": "~5.6",
    "typescript-eslint": "^8",
    "vitest": "^2.1"
  }
}
